{
  "info": {
    "name": "QuantReplay REST API",
    "description": "Manual REST checks for the QuantReplay market simulator (venue XETRA). Docs: https://quod-financial.github.io/quantreplay/RESTAPI/RESTAPI.html",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9050"
    },
    {
      "key": "venueId",
      "value": "XETRA"
    },
    {
      "key": "symbol",
      "value": "VOW"
    }
  ],
  "item": [
    {
      "name": "Settings",
      "item": [
        {
          "name": "Get settings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Venues",
      "item": [
        {
          "name": "Get venues",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/venues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "venues"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"XETRA present\", () => pm.expect(pm.response.json().venues.map(v => v.id)).to.include(pm.collectionVariables.get(\"venueId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get venue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/venues/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "venues",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "Get listings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "listings"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Demo symbols present\", () => { const s = pm.response.json().listings.map(l => l.symbol); [\"AMZ\",\"MSF\",\"NFC\",\"VODI\",\"VOW\"].forEach(x => pm.expect(s).to.include(x)); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get listing by symbol",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/listings/{{symbol}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "listings",
                "{{symbol}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Venue status",
      "item": [
        {
          "name": "Get venue status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/venuestatus/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "venuestatus",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all venue status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/allvenuestatus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allvenuestatus"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Order generation",
      "item": [
        {
          "name": "Get generator status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genstatus/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genstatus",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stop generator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genstop/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genstop",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Start generator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/genstart/{{venueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "genstart",
                "{{venueId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}